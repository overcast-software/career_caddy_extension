{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Decorators. LEGACY, matching what the build actually does: every file
    // (.ts and .gts alike) goes through babel + decorator-transforms, which
    // implements the legacy protocol. This has to agree with vite.config.mjs's
    // `enforce: 'pre'` — when the two disagreed, .ts got TC39 decorators while
    // .gts got legacy, and the two protocols in one bundle produced "Invalid
    // value used as weak map key" at module eval: a blank panel with a clean
    // console.
    //
    // It was `false` here on the theory that TypeScript need only accept the
    // syntax. It does not: with TC39 semantics assumed, every single @tracked
    // fails to typecheck (TS1240 x43). The compiler models the protocol, so it
    // has to be told which one.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    // strict is the whole point of choosing TypeScript. It turns on, among
    // others, strictNullChecks -- which is what makes `number | undefined`
    // mean something and forces the guards in lib/panel.ts.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // .gts files import each other with the extension included; this lets
    // ordinary .ts imports do the same so every import in the codebase looks
    // alike.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    // ember-source publishes NO "types" entry and exposes its packages only
    // as the subpath export "./*", so `import { tracked } from
    // '@glimmer/tracking'` resolves to nothing for TypeScript — the same
    // problem vite.config.mjs solves at bundle time with emberSourceResolver.
    // These paths are the compiler's half of that arrangement; the two must
    // stay in step, because a mapping that only exists in one of them means
    // code that type-checks and will not bundle, or the reverse.
    //
    // @glimmer/component is listed FIRST and explicitly: it is a real npm
    // package with its own declarations, and the @glimmer/* wildcard below
    // would otherwise capture it and send it into ember-source, where it does
    // not live.
    "paths": {
      "@glimmer/component": ["./node_modules/@glimmer/component/dist/index.d.ts"],
      "@glimmer/*": ["./node_modules/ember-source/types/stable/@glimmer/*"],
      "@ember/*": ["./node_modules/ember-source/types/stable/@ember/*"]
    },
    "types": ["chrome"]
  },
  "include": ["src/**/*.ts", "src/**/*.gts", "*.mjs"],

  // NOTE: plain `tsc` cannot parse .gts -- the <template> tag is not
  // TypeScript syntax. Type-checking templates needs Glint
  // (`@glint/core` + `@glint/environment-ember-template-imports`), which is
  // the natural next addition: it is what makes a component Signature actually
  // checked at the call site rather than merely documented.
  "glint": {
    "environment": "ember-template-imports"
  }
}
